# Server
PORT=3000
CORS_ORIGINS=

# External Hermes REST API
# Generate with: openssl rand -hex 32
KINOLIKE_API_TOKEN=replace_with_a_long_random_token
# Bind the token to exactly one existing KinoLike account (ID is preferred).
KINOLIKE_API_USER_ID=1
KINOLIKE_API_USERNAME=
KINOLIKE_API_ENABLED=true
KINOLIKE_API_RATE_LIMIT=120
KINOLIKE_API_RATE_WINDOW_MS=60000
# Swagger UI is automatically enabled outside production. Set true to expose it in production.
KINOLIKE_API_DOCS=false
# Consumed by Hermes/deployment configuration; never hard-code host or port in the agent.
KINOLIKE_API_URL=http://app:3000/api/v1
KINOLIKE_PORT=3001

# PostgreSQL (docker-compose переопределяет PGHOST на db)
POSTGRES_DB=kinolike
POSTGRES_USER=kinolike
POSTGRES_PASSWORD=kinolike_secret
PGHOST=db
PGPORT=5432
PGDATABASE=kinolike
PGUSER=kinolike
PGPASSWORD=kinolike_secret

# TMDB
TMDB_API_KEY=your_tmdb_api_key_here

# TrailerResolver: Rutube is used first without credentials; other providers are optional.
TRAILER_CACHE_HOURS=720
YOUTUBE_API_KEY=
VK_VIDEO_ACCESS_TOKEN=
VIMEO_ACCESS_TOKEN=

# Jellyfin (опционально — для кнопки "Смотреть")
JELLYFIN_URL=
JELLYFIN_PORT=8096
JELLYFIN_API_KEY=
# Jellyfin access token of the account that watches through KinoLike. It is
# required for PlaybackPositionTicks; an administrative API key alone cannot
# update a user's resume position.
JELLYFIN_USER_TOKEN=
# Lampac NextGen stays private on the LAN; its port is never published by KinoLike.
# Override for another private Lampac host or a shared Docker service network.
LAMPAC_URL=http://192.168.1.103:9118
PHANTOM_TIMEOUT_MS=7000
# Set true temporarily to log Phantom lookup query parameters and normalized
# season/episode/translation metadata. Stream URLs and their tokens are never logged.
PHANTOM_DIAGNOSTICS=false
VIDEOHUB_TIMEOUT_MS=10000
# Set true temporarily to trace VideoHUB HLS playlist/segment requests.
# URLs and stream tokens are not logged.
STREAMING_DIAGNOSTICS=false
# Playback heartbeat safety net (minimum accepted stale timeout: 120000 ms)
PLAYBACK_STALE_TIMEOUT_MS=180000
PLAYBACK_WATCHDOG_INTERVAL_MS=60000
# Set true temporarily to log browser-to-Jellyfin proxy disconnects.
PLAYBACK_DEBUG=false

# Jackett/Torrent parser и TorrServer (опционально)
TORRENT_PARSER_URL=
TORRENT_PARSER_API_KEY=
TORRSERVER_URL=
TORRSERVER_PORT=8091
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=
MOVIES_DIR=/mnt/server/movies
SERIALS_DIR=/mnt/server/serials

# JWT
JWT_SECRET=your_jwt_secret_here

# AI (OpenAI-compatible)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_TIMEOUT=30
# Bound a single AI-search call. On timeout KinoLike uses its local parser;
# do not let retries and a second LLM call consume the reverse-proxy budget.
AI_SEARCH_LLM_TIMEOUT_MS=15000
# Optional experiment only; disabled because deterministic ranking is faster.
AI_RERANK_ENABLED=false
AI_RECOMMENDATIONS_LIMIT=20
AI_CACHE_TTL=24
RECOMMENDATIONS_CACHE_TTL=24
RECOMMENDATIONS_DEBOUNCE_MS=1500

# Proxy for TMDB
TMDB_PROXY_ENABLED=false
TMDB_PROXY_TYPE=socks5
TMDB_PROXY_HOST=127.0.0.1
TMDB_PROXY_PORT=1080
TMDB_PROXY_USERNAME=
TMDB_PROXY_PASSWORD=
# Or VLESS
# TMDB_PROXY_TYPE=vless
# TMDB_PROXY_VLESS_UUID=your_uuid_here
# TMDB_PROXY_VLESS_ADDRESS=your-domain.com
# TMDB_PROXY_VLESS_PORT=443
# TMDB_PROXY_VLESS_TLS=true
# TMDB_PROXY_VLESS_FLOW=xtls-rprx-vision

# IMDb Non-Commercial Datasets
IMDB_DATA_DIR=/app/data/imdb
IMDB_IMPORT_BATCH_SIZE=5000
# Автопланировщик обновляет только компактный title.ratings dataset.
# Полный импорт фильмографии запускается отдельно через update-imdb-data.
IMDB_AUTO_UPDATE=false
IMDB_UPDATE_INTERVAL_HOURS=24
IMDB_UPDATE_INITIAL_DELAY_MINUTES=10
IMDB_TMDB_TITLE_SYNC_LIMIT=2000
IMDB_TMDB_PERSON_SYNC_LIMIT=2000
IMDB_TMDB_RESOLVE_LIMIT=500
IMDB_RESOLVE_ON_PERSON_LIMIT=12

# Public streaming-service popularity snapshots. Data is fetched server-side;
# set false to disable the background updater in an isolated deployment.
STREAMING_TRENDING_ENABLED=true
STREAMING_TRENDING_INTERVAL_HOURS=1
